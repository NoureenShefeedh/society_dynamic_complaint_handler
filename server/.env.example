# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Supabase Postgres — use the POOLED connection string)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Supabase (for Storage — photo uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=complaint-photos

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email (Nodemailer + Gmail app password, or swap for Resend later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM="Society Tracker <your-email@gmail.com>"

# Overdue check job
OVERDUE_CHECK_INTERVAL_MINUTES=60
